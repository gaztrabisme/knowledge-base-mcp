# Copy to .env and edit. All values are optional — sensible defaults apply.
# These can also be set as the `env` block of your MCP server config.

# --- Paths ---------------------------------------------------------------
# Where the tool WRITES its outputs (markdown, chunks, qdrant index, manifest).
# Default: ./data in a source checkout, else an OS per-user data dir.
# KB_DATA_DIR=/absolute/path/to/kb-data
# Where YOUR source documents live (the corpus to ingest).
# Default: ./examples/sample-docs
# KB_DOCS_DIR=/absolute/path/to/my-docs

# --- Compute -------------------------------------------------------------
# auto (prefer CUDA, then Apple MPS, then CPU) | cuda | mps | cpu
# KB_DEVICE=auto
# Index-time embedding batch size (GPU memory-bound; lower if you OOM).
# KB_INDEX_BATCH=48

# --- Models (swap for licensing or quality) ------------------------------
# Default embedder is CC BY-NC 4.0 (non-commercial). For commercial use, swap to
# a permissive model (e.g. BAAI/bge-small-en-v1.5, MIT) and re-index.
# KB_EMBEDDING_MODEL=jinaai/jina-embeddings-v5-text-small-retrieval
# KB_RERANKER_MODEL=cross-encoder/ettin-reranker-150m-v1
# KB_RERANK_INPUT=manifest   # manifest | child | heading

# --- Optional contextual enrichment (OpenAI-compatible endpoint; off by default) -
# KB_ENRICH_BASE_URL=http://localhost:1234/v1
# KB_ENRICH_MODEL=your-local-model

# --- Research / eval harness only (NOT needed to use the tool) -----------
# DEEPSEEK_API_KEY=
